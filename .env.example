PORT=4000
APP_URL=http://localhost:3000
# MongoDB Atlas or another replica set is required for atomic booking transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/studiospace?replicaSet=rs0
MONGODB_DATABASE=studiospace
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-a-different-32-character-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IMGBB_API_KEY=
# Used only when explicitly running npm run seed:
SEED_HOST_EMAIL=host@studiospace.example
SEED_HOST_PASSWORD=
SEED_CREATOR_EMAIL=creator@studiospace.example
SEED_CREATOR_PASSWORD=
